# ------------------------------------------------------------------
# SpinUp environment configuration
#
# Copy this file to `.env.local` (never commit real secrets) and fill in
# the values. The app validates these on startup (see src/lib/env.ts) and
# refuses to boot if a REQUIRED value is missing.
# ------------------------------------------------------------------

# --- Supabase (REQUIRED) ------------------------------------------
# Project URL and keys. Anon key is safe to expose to the browser;
# the service-role key is SECRET and server-only — it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App URL (REQUIRED) -------------------------------------------
# Public base URL of this deployment. Used for auth redirects, email
# links, and Trello OAuth/webhook callback URLs. No trailing slash.
NEXT_PUBLIC_APP_URL=https://app.example.com

# --- Email via Resend (OPTIONAL) ----------------------------------
# Required only for outbound email (team invites, job-board outreach,
# mentor applications). If unset, email sending is skipped/disabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SpinUp <noreply@example.com>

# --- Trello integration (OPTIONAL) --------------------------------
# Required only if you enable the Trello board sync.
# TRELLO_API_KEY is your Trello API key; TRELLO_API_SECRET is the
# matching OAuth secret used to verify inbound webhook signatures.
TRELLO_API_KEY=
TRELLO_API_SECRET=
